# ===== 大模型 (DeepSeek, OpenAI 兼容) =====
LLM_API_KEY=sk-your-deepseek-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_MODEL_MINI=deepseek-chat

# ===== Embedding (可选, 不填自动用本地 bge-small-zh ~100MB) =====
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ===== QQ 邮箱 SMTP (免费, 每天 500 封) =====
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-qq@qq.com
SMTP_PASSWORD=your-auth-code

# ===== MySQL =====
DB_NAME=dev-assistant
DB_USER=root
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=3306
DB_CHARSET=utf8mb4

# ===== 搜索 API =====
TAVILY_API_KEY=tvly-your-key-here

# ===== LangSmith (可观测性, 可选) =====
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false

# ===== 其他 =====
DEBUG=true
