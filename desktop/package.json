{
  "name": "dev-assistant",
  "version": "1.0.0",
  "description": "DevAssistant - AI 编程助手桌面端",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "package:mac": "electron-builder --mac",
    "package:mac-arm64": "electron-builder --mac --arm64",
    "package:mac-x64": "electron-builder --mac --x64"
  },
  "build": {
    "appId": "com.devassistant.app",
    "productName": "DevAssistant",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "../frontend/dist/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": ["dmg", "zip"],
      "icon": "icons/icon.icns",
      "hardenedRuntime": true
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
